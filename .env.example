# ===================================================================
# SANKHYA PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env or export these variables into your environment
# ===================================================================

# Application Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration (Required for MySQL execution)
DB_URL=jdbc:mysql://localhost:3306/sankhya_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Future AI Integration (Reserved for Phase 5 Gemini Analytics Explanation)
# Do not use in Phase 1
GEMINI_API_KEY=your_gemini_api_key_placeholder
