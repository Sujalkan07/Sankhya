# Sankhya Environment Configuration Example
# Copy this file to .env and configure your secrets
# DO NOT COMMIT THE ACTUAL .env FILE

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration (Defaults in application.yml)
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/sankhya_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=
